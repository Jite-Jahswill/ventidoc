{
  "name": "@ventidoc/emails",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "lint": "eslint --config ../../eslint.config.mjs .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --env-file-if-exists=../../.env node_modules/vitest/vitest.mjs run",
    "email:dev": "node --env-file-if-exists=../../.env node_modules/react-email/dist/cli/index.mjs dev --dir src/templates --port 3200"
  },
  "dependencies": {
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.3.0",
    "@ventidoc/config": "workspace:*",
    "@ventidoc/db": "workspace:*",
    "drizzle-orm": "0.45.4",
    "nodemailer": "10.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "6.37.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@react-email/ui": "6.11.10",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react-email": "6.11.10",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
