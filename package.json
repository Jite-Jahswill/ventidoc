{
  "name": "ventidoc",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d postgres mailpit",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @ventidoc/db db:generate",
    "db:migrate": "pnpm --filter @ventidoc/db db:migrate",
    "db:seed": "pnpm --filter @ventidoc/db db:seed",
    "db:reset": "pnpm --filter @ventidoc/db db:reset",
    "email:dev": "pnpm --filter @ventidoc/emails email:dev"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
