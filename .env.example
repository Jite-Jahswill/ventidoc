# Runtime app role: ventidoc_app. No DDL rights, not a table owner, cannot
# bypass Row-Level Security. This is the role the application connects as.
DATABASE_URL=postgresql://ventidoc_app:ventidoc_app@localhost:5433/ventidoc
DATABASE_URL_TEST=postgresql://ventidoc_app:ventidoc_app@localhost:5433/ventidoc_test

# Migration role: ventidoc_owner. Owns every table, runs migrations and seeds.
# Used only by drizzle-kit and packages/db's withSystem() — never by request
# handling code.
DATABASE_MIGRATION_URL=postgresql://ventidoc_owner:ventidoc_owner@localhost:5433/ventidoc
DATABASE_MIGRATION_URL_TEST=postgresql://ventidoc_owner:ventidoc_owner@localhost:5433/ventidoc_test

APP_URL=http://localhost:3000

# smtp | resend
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM="Ventidoc <no-reply@ventidoc.local>"

# Only required when EMAIL_PROVIDER=resend
RESEND_API_KEY=
